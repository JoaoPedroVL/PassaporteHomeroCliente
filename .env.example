# Copie este arquivo para `.env` e preencha com as credenciais do projeto
# Supabase (Dashboard → Project Settings → API).
#
# O `.env` está no .gitignore e não deve ser versionado.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA

# Canal oficial do encarregado de dados/DPO exibido no aviso de privacidade.
PRIVACY_CONTACT_EMAIL=privacidade@seudominio.com.br
